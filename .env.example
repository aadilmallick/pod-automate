# Runtime
NODE_ENV=development
HOST=localhost
PORT=3000
# Public host port; defaults to PORT and is separate from the container bind port.
API_PUBLIC_PORT=3000
PUBLIC_HOST=localhost
WEB_BIND_HOST=localhost
PUBLIC_WEB_HOST=localhost
WEB_HOST=localhost
WEB_PORT=5173
# Optional Vite proxy override, useful when the API runs on another host/port.
# API_PROXY_HOST=localhost
# API_PROXY_TARGET can be set explicitly when the API is remote.
# Optional full URL overrides; otherwise derived from host + port
# APP_URL can be set explicitly for production/OAuth; otherwise derive it from PUBLIC_HOST + PORT.
# WEB_URL can be set explicitly for production; otherwise derive it from PUBLIC_WEB_HOST + WEB_PORT.
# Public canonical URL used in Open Graph/Twitter metadata. Set this to your deployed HTTPS origin.
# PUBLIC_SITE_URL=https://your-domain.example
DATABASE_URL=postgres://pod:pod@localhost:5432/pod_automator
REDIS_URL=redis://localhost:6379
AUTH_SECRET=replace-with-a-long-random-string
AUTH_MODE=development

# AI providers (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
# Hugging Face access token (server-side only). Create one at https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-9B
# Ollama local HTTP API. x/flux2-klein is the default; x/flux2-klein:9b is available in connection settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_IMAGE_MODEL=x/flux2-klein
OLLAMA_IMAGE_MODEL_9B=x/flux2-klein:9b
AI_PROVIDER=openrouter

# Storage: local or s3
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
# PUBLIC_ASSET_URL can be set explicitly; otherwise it derives from APP_URL.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pod-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Optional Google OAuth, enabled by setting AUTH_MODE=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI can be set explicitly; otherwise it derives from APP_URL.
